# ==============================================================
# ProfileImg-Plugin 图库配置（第三方图库）
# default 图库路径在 config.yaml 的 gallery.defaultDir 中配置（见锅巴"default 图库上传"）
# ==============================================================

# ---------- 第三方图库（只读，git pull 更新后复制到主图库） ----------
# 第三方仓库的目录结构通常与 miao-plugin-ProfileImg 不同，
# 需用 normalPath / superPath 指定角色目录相对【仓库根】的路径：
#   "normal-character" → 仓库根/normal-character/角色名/   （有类型层）
#   "."                → 角色目录直接挂在仓库根（仓库根/角色名/）
#   空                 → 该类型不存在
# dir 为 PROFILE_IMG_DIR（gallery/ProfileImg/）下的子目录名，如 "xxx-fan-repo"，
# 实际路径: plugins/ProfileImg-Plugin/resources/gallery/ProfileImg/xxx-fan-repo
# 可用 #下载第三方图库 <URL> 命令自动下载并注册，无需手动填写
thirdParty:
  # - name: "某同人图库"                        # 图库名（用于文件名前缀与显示）
  #   dir: "xxx-fan-repo"                      # gallery/ProfileImg/ 下的子目录名
  #   remoteUrl: "https://github.com/xxx/xxx.git"  # Git 远程地址
  #   normalPath: "normal-character"            # normal 角色目录相对仓库根的路径（"."=角色目录在根，空=无）
  #   superPath: ""                             # super 角色目录相对仓库根的路径（空=无）
  #   enabled: true                             # 是否参与 #更新第三方图库
