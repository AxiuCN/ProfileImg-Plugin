# ==============================================================
# ProfileImg-Plugin 图库配置（第三方图库）
# 默认图库固定为 miao-plugin/resources/profile（由 miao 的 profileImgSrc 首项决定，不可自定义）
# ==============================================================

# ---------- 第三方图库（只读 git 图库源，目录结构自动探测） ----------
# 第三方仓库作为独立只读图库源注册给 miao（不再复制到主图库），支持三种结构：
#   normal-character/{角色}/ 与 super-character/{角色}/   （分层，含彩蛋立绘）
#   {角色}/                                             （平铺，仅普通立绘；仓库根不要放 docs 等含图目录）
#   {分组}/{角色}/                                       （一层分组：如按游戏分层的 gs-character / sr-character，
#                                                        或任意命名的分组；每个可直读子目录各自注册为一个源）
#
# 登记要求：第三方图库**必须在本列表中登记**才会被读取（本文件是唯一凭证，不做目录扫描）；
#   跨盘 / 网络盘图库只能在此填写；gallery/ProfileImg 下已有的图库目录会被启动时自动补登记
#
# dir —— 图库目录，一律**绝对路径**（正斜杠），这是图库位置的唯一凭证：
#   本机其他路径：如 "E:/fan-repo"
#   网络盘（UNC）：如 "//NAS/gallery/fan"，需先执行一次
#     git config --global --add safe.directory <该路径>（否则 git 以 dubious ownership 拒绝操作）
#   旧配置里的相对子目录名仍兼容读取（相对 gallery/ProfileImg）
#   本地已有图库（非 git 目录也可以）直接填其绝对路径即可，无需下载
#
# remoteUrl —— 远程地址，可留空：留空表示本地只读源（不参与 #更新第三方图库）
thirdParty:
  # - name: "某同人图库"                           # 图库名（显示用）
  #   dir: "D:/Yunzai/app/plugins/ProfileImg-Plugin/resources/gallery/ProfileImg/xxx-fan-repo"
  #   remoteUrl: "https://github.com/xxx/xxx.git"  # 可留空 = 本地只读源
  #   enabled: true                                # 是否参与 #更新第三方图库 与图库源注册
  #
  # - name: "跨盘图库"                             # 自定义路径 / 跨盘示例
  #   dir: "E:/gallery/fan-repo"                   # 绝对路径（网络盘写 //NAS/gallery/fan）
  #   remoteUrl: "https://github.com/xxx/fan.git"
  #   enabled: true
  #
  # - name: "本地图库"                             # 本地已有图库、无远程地址示例
  #   dir: "E:/my-profile-images"
  #   remoteUrl: ""
  #   enabled: true
