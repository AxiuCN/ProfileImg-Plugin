# ==============================================================
# ProfileImg-Plugin 图库配置
# 管理 default 图库与第三方图库（主图库仓库元数据在 config.yaml 的 gallery.repos）
# ==============================================================

# ---------- default 图库 ----------
# 手动上传面板图的默认存放目录（非 git，本地可写）
# dir 为绝对路径，或相对云崽根目录（app/）的路径；留空表示未配置
default:
  dir: ""

# ---------- 第三方图库（只读，git pull 更新后复制到主图库） ----------
# 第三方仓库的目录结构通常与 miao-plugin-ProfileImg 不同，
# 需用 normalPath / superPath 指定角色目录在仓库内的相对位置（可为空表示该类型不存在）
thirdParty:
  # - name: "某同人图库"                        # 图库名（用于文件名前缀与显示）
  #   dir: "plugins/xxx-fan-repo"              # 仓库本地目录（绝对路径或相对 app/ 根）
  #   remoteUrl: "https://github.com/xxx/xxx.git"  # Git 远程地址
  #   normalPath: "normal-character"            # normal 角色目录相对路径（空=无）
  #   superPath: ""                             # super 角色目录相对路径（空=无）
  #   enabled: true                             # 是否参与 #更新第三方图库
