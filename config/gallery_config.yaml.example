# ==============================================================
# ProfileImg-Plugin 图库配置（第三方图库）
# default 图库路径在 config.yaml 的 gallery.defaultDir 中配置（见锅巴"default 图库上传"）
# ==============================================================

# ---------- 第三方图库（只读 git 图库源，目录结构自动探测） ----------
# 第三方仓库作为独立只读图库源注册给 miao（不再复制到主图库），支持两种结构：
#   normal-character/{角色}/ 与 super-character/{角色}/   （分层，含彩蛋立绘）
#   {角色}/                                             （平铺，仅普通立绘；仓库根不要放 docs 等含图目录）
# 结构无法直读时不会被注册，命令会提示整理目录；整理后执行 #更新第三方图库 或重启 Yunzai 重新注册
# dir 为 PROFILE_IMG_DIR（gallery/ProfileImg/）下的子目录名，也可填绝对路径，
# 实际路径: plugins/ProfileImg-Plugin/resources/gallery/ProfileImg/xxx-fan-repo
# 可用 #下载第三方图库 <URL> 命令自动下载并注册，无需手动填写
# 注：normalPath / superPath 为旧版字段，新布局已不使用（保留兼容读取，可留空）
thirdParty:
  # - name: "某同人图库"                        # 图库名（显示用）
  #   dir: "xxx-fan-repo"                      # gallery/ProfileImg/ 下的子目录名
  #   remoteUrl: "https://github.com/xxx/xxx.git"  # Git 远程地址
  #   enabled: true                             # 是否参与 #更新第三方图库 与图库源注册
