# ==============================================================
# ProfileImg-Plugin 配置文件
# ==============================================================
gallery:
  # ---------- 统一自动更新 ----------
  # 所有图库共用此 cron，按主图库 → 屏蔽图库 → 第三方图库 → 图库源同步顺序执行
  autoUpdate:
    enabled: true
    cron: "0 30 5 * * *"

  # ---------- 主图库仓库元数据 ----------
  # 仓库列表由 map.json 的 mapping values 自动发现（仓库 0 始终活跃）
  # 此处仅提供各仓库的元数据补丁（URL / 开关），未配置的仓库使用默认值
  repos:
    - id: 0
      name: "miao-plugin-ProfileImg"
      remoteUrl: "https://github.com/AxiuCN/miao-plugin-ProfileImg.git"
      autoUpdate: true

  # ---------- 默认图库 ----------
  # 主人手动上传面板图的存放目录名（位于 gallery/ProfileImg/ 下），留空则写入默认图库
  # 实际路径：plugins/ProfileImg-Plugin/resources/gallery/ProfileImg/<目录名>
  defaultDir: ""

  # ---------- 屏蔽图库 ----------
  blocked:
    enabled: true
    remoteUrl: "https://github.com/AxiuCN/miao-plugin-ProfileImg-Blocked.git"

  # ---------- 第三方图库自动更新 ----------
  # 检测到第三方图库新版本时自动 pull（第三方仓库作为只读图库源，不再复制）
  thirdPartyUpdate:
    enabled: true

# ---------- 上传压缩设置 ----------
upload:
  enabled: false
  format: "webp"
  maxSize: 500
