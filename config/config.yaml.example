# ==============================================================
# ProfileImg-Plugin 配置文件
# ==============================================================
gallery:
  # ---------- 主图库仓库列表 ----------
  # 至少需要一个 id=0 的默认仓库
  repos:
    - id: 0
      name: "miao-plugin-ProfileImg"
      remoteUrl: "https://github.com/AxiuCN/miao-plugin-ProfileImg.git"
      enabled: true
      cron: "0 20 5 * * *"
      autoUpdate: true
      autoRestart: false

  # ---------- 屏蔽图库 ----------
  blocked:
    enabled: true
    remoteUrl: "https://github.com/AxiuCN/miao-plugin-ProfileImg-Blocked.git"
    cron: "0 40 5 * * *"
    autoUpdate: true
    autoRestart: false

# ---------- 上传压缩设置 ----------
upload:
  enabled: false
  format: "webp"
  maxSize: 500
