# ==============================================================
# ProfileImg-Plugin 配置文件
# ==============================================================
gallery:
  # ---------- 主图库仓库元数据 ----------
  # 仓库列表由 map.json 的 mapping values 自动发现（仓库 0 始终活跃）
  # 此处仅提供各仓库的元数据补丁（URL / cron / 开关），未配置的仓库使用默认值
  repos:
    - id: 0
      name: "miao-plugin-ProfileImg"
      remoteUrl: "https://github.com/AxiuCN/miao-plugin-ProfileImg.git"
      enabled: true
      cron: "0 20 5 * * *"
      autoUpdate: true
      autoRestart: false

  # ---------- default 图库 ----------
  # 手动添加面板图的默认存放目录（非 git，本地维护）
  # 留空 → 手动添加按 map.json 路由到主图库
  # 若指向 miao-plugin-ProfileImg 目录 → 手动添加按 map.json 分类到各主仓库
  defaultDir: ""

  # ---------- 第三方图库（只读，pull 同步） ----------
  # 同角色可横跨多个图库；display n 从 500001 起按仓库序号分段
  thirdParty:
    # - name: "xxx-fan-repo"
    #   dir: "plugins/ProfileImg-Plugin/resources/gallery/ProfileImg/xxx-fan-repo"
    #   remoteUrl: "https://github.com/xxx/xxx.git"

  # ---------- 屏蔽图库 ----------
  blocked:
    enabled: true
    remoteUrl: "https://github.com/AxiuCN/miao-plugin-ProfileImg-Blocked.git"
    cron: "0 40 5 * * *"
    autoUpdate: true
    autoRestart: false

# ---------- 上传压缩设置 ----------
upload:
  enabled: false
  format: "webp"
  maxSize: 500
