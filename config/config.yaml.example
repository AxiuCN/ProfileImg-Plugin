# ==============================================================
# ProfileImg-Plugin 配置文件
# ==============================================================
gallery:
  # ---------- 主图库仓库元数据 ----------
  # 仓库列表由 map.json 的 mapping values 自动发现（仓库 0 始终活跃）
  # 此处仅提供各仓库的元数据补丁（URL / cron / 开关），未配置的仓库使用默认值
  repos:
    - id: 0
      name: "miao-plugin-ProfileImg"
      remoteUrl: "https://github.com/AxiuCN/miao-plugin-ProfileImg.git"
      enabled: true
      cron: "0 20 5 * * *"
      autoUpdate: true
      autoRestart: false

  # ---------- default 图库 ----------
  # 手动上传面板图的默认存放目录名（位于 gallery/ProfileImg/ 下），为空时使用默认图库 default
  # 实际路径：plugins/ProfileImg-Plugin/resources/gallery/ProfileImg/<目录名>
  defaultDir: ""

  # ---------- 屏蔽图库 ----------
  blocked:
    enabled: true
    remoteUrl: "https://github.com/AxiuCN/miao-plugin-ProfileImg-Blocked.git"
    cron: "0 40 5 * * *"
    autoUpdate: true
    autoRestart: false

  # ---------- 第三方图库自动更新 ----------
  # 检测到第三方图库新版本时自动 pull 并复制新图到主图库
  thirdPartyUpdate:
    enabled: false
    cron: ""
    autoUpdate: false

# ---------- 上传压缩设置 ----------
upload:
  enabled: false
  format: "webp"
  maxSize: 500
